<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="G:/My Drive/optimising-kiwifruit-export/02_data_processed/star_schema/kiwifruit_export.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="6387"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="3" parent="0"/><expanded_item id="4" parent="0"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="dim_corridor" custom_title="0" dock_id="1" table="4,12:maindim_corridor"/><dock_state state="000000ff00000000fd0000000100000002000004010000020bfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000004010000011800ffffff000002620000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="dim_corridor" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="79"/><column index="2" value="78"/><column index="3" value="55"/><column index="4" value="109"/><column index="5" value="133"/><column index="6" value="107"/><column index="7" value="145"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT
    t.season_year,
    CASE
        WHEN f.dm_pct_avg &lt; 15.5  THEN 'MTS Fail'
        WHEN f.dm_pct_avg &lt;= 16.1 THEN 'Green MTS'
        ELSE                           'SunGold'
    END AS mts_category,
    COUNT(*) AS total_shipments,
	ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (PARTITION BY t.season_year),1) AS total_pct_season
	
FROM fact_export_transactions f
JOIN dim_time t ON f.date_key = t.date_key
GROUP BY t.season_year, mts_category
ORDER BY t.season_year, mts_category;</sql><current_tab id="0"/></tab_sql></sqlb_project>
