<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="apophenia_star.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="4529"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="dim_corridor" custom_title="0" dock_id="3" table="4,12:maindim_corridor"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- Ver el schema completo de todas las tablas de la base (columnas, tipos, FKs)
SELECT sql FROM sqlite_master WHERE type='table';


-- Rankear las entregas de cada grower por valor total, de mayor a menor
-- (ROW_NUMBER reinicia el conteo en cada grower gracias al PARTITION BY)
SELECT 
    submission_id,
    grower_id,
    total_value_nzd,
    ROW_NUMBER() OVER (
        PARTITION BY grower_id 
        ORDER BY total_value_nzd DESC
    ) AS rank_value
FROM fact_pallet_submissions;


-- Ver todas las columnas y filas de la tabla fact_pallet_submissions (chequeo rápido de estructura/datos)
SELECT * FROM fact_pallet_submissions;


-- Encontrar la entrega con MAYOR delay_hours (peor demora) por cada packhouse
-- Subquery interno calcula el ranking, el WHERE externo se queda solo con el top 1 de cada grupo
SELECT * FROM (
    SELECT 
        submission_id, packhouse_id, delay_hours,
        ROW_NUMBER() OVER (PARTITION BY packhouse_id ORDER BY delay_hours DESC) AS rank_delay
    FROM fact_pallet_submissions
) sub
WHERE rank_delay = 1;


-- &quot;Smell test&quot;: contar cuántas veces se repite cada valor de delay_hours
-- Sirve para detectar si un valor &quot;sospechoso&quot; (ej: un máximo repetido) es un patrón real o un error de datos
SELECT delay_hours, COUNT(*) as veces
FROM fact_pallet_submissions
GROUP BY delay_hours
ORDER BY veces DESC
LIMIT 10;


-- Comparar RANK() vs ROW_NUMBER() en un solo packhouse
-- Objetivo: ver cómo RANK() maneja los empates en delay_hours (salta números), 
-- a diferencia de ROW_NUMBER() que los ignora y sigue consecutivo
SELECT 
    submission_id, 
    packhouse_id, 
    delay_hours,
    RANK() OVER (PARTITION BY packhouse_id ORDER BY delay_hours DESC) AS rank_delay
FROM fact_pallet_submissions
WHERE packhouse_id = 1
ORDER BY delay_hours DESC;


-- Comparación de RANK y DENSE_RANK en Packhouse 1
-- Objetivo: Observar el comportamiento de los empates (12.0 hrs) y cómo se reanuda el conteo.
SELECT 
    submission_id, 
    packhouse_id, 
    delay_hours,
    -- RANK() dejará a todos los empates en 1, pero saltará posiciones en el siguiente número
    RANK() OVER (
        PARTITION BY packhouse_id 
        ORDER BY delay_hours DESC
    ) AS ranking_con_salto,
    
    -- DENSE_RANK() dejará a todos los empates en 1, y el siguiente número será consecutivamente el 2
    DENSE_RANK() OVER (
        PARTITION BY packhouse_id 
        ORDER BY delay_hours DESC
    ) AS ranking_denso
FROM fact_pallet_submissions
WHERE packhouse_id = 1
ORDER BY delay_hours DESC;

-- Resumen agrupado de RANK y DENSE_RANK para Packhouse 1
-- Objetivo: Contar cuántas filas caen en cada puesto del ranking sin mostrar todo el detalle.
SELECT 
    ranking_con_salto,
    ranking_denso,
    COUNT(*) AS cantidad_de_filas
FROM (
    SELECT 
        packhouse_id,
        delay_hours,
        RANK() OVER (PARTITION BY packhouse_id ORDER BY delay_hours DESC) AS ranking_con_salto,
        DENSE_RANK() OVER (PARTITION BY packhouse_id ORDER BY delay_hours DESC) AS ranking_denso
    FROM fact_pallet_submissions
    WHERE packhouse_id = 1
) subquery_ranking
GROUP BY ranking_con_salto, ranking_denso
ORDER BY ranking_con_salto ASC;

-- Listar todas las tablas reales que existen en la base de datos actual
-- Objetivo: Verificar los nombres exactos de las tablas para corregir el error de &quot;no such table&quot;.
SELECT name 
FROM sqlite_master 
WHERE type='table';

-- Comparación de ROW_NUMBER, RANK y DENSE_RANK sobre valores de pallets
-- Objetivo: Evaluar cómo trata cada función los montos máximos en dólares (NZD) por Packhouse.
SELECT 
    submission_id,
    packhouse_id,
    total_value_nzd,
    -- ROW_NUMBER: Conteo secuencial puro por packhouse
    ROW_NUMBER() OVER (
        PARTITION BY packhouse_id 
        ORDER BY total_value_nzd DESC
    ) AS rn,
    
    -- RANK: Mismo puesto si empatan en NZD, pero salta posiciones después
    RANK() OVER (
        PARTITION BY packhouse_id 
        ORDER BY total_value_nzd DESC
    ) AS rk,
    
    -- DENSE_RANK: Mismo puesto si empatan en NZD, y sigue de manera consecutiva
    DENSE_RANK() OVER (
        PARTITION BY packhouse_id 
        ORDER BY total_value_nzd DESC
    ) AS drk
FROM fact_pallet_submissions
WHERE packhouse_id = 1 -- Nos quedamos con la packhouse 1 para analizar el bloque de arriba cómodamente
LIMIT 20; -- Traemos las primeras 20 filas para ver el tope del ranking


-- Forzar empates usando delay_hours para ver la diferencia real entre rankings
-- Objetivo: Analizar cómo reacciona cada función en las primeras filas cuando el valor es idéntico (12.0).
SELECT 
    submission_id,
    packhouse_id,
    delay_hours,
    -- ROW_NUMBER: Secuencial, va a poner 1, 2, 3... aunque todos sean 12.0
    ROW_NUMBER() OVER (
        PARTITION BY packhouse_id 
        ORDER BY delay_hours DESC
    ) AS rn,
    
    -- RANK: Va a poner 1 a todos los de 12.0
    RANK() OVER (
        PARTITION BY packhouse_id 
        ORDER BY delay_hours DESC
    ) AS rk,
    
    -- DENSE_RANK: Va a poner 1 a todos los de 12.0
    DENSE_RANK() OVER (
        PARTITION BY packhouse_id 
        ORDER BY delay_hours DESC
    ) AS drk
FROM fact_pallet_submissions
WHERE packhouse_id = 1
LIMIT 20;


SELECT * FROM (
    SELECT 
        submission_id, packhouse_id, delay_hours,
        ROW_NUMBER() OVER (PARTITION BY packhouse_id ORDER BY delay_hours DESC) AS rank_delay
    FROM fact_pallet_submissions
) sub
WHERE rank_delay = 1;


SELECT * FROM fact_pallet_submissions LIMIT 10;

-- Obtener el Top 3 de los valores de pallets más altos para la Packhouse 1
-- Objetivo: Usar DENSE_RANK para evitar saltos en el podio si hay empates de dinero.
SELECT * FROM (
    SELECT 
        submission_id, -- Sumamos el ID de entrega para saber cuál es
        packhouse_id, 
        total_value_nzd,
        DENSE_RANK() OVER (
            PARTITION BY packhouse_id 
            ORDER BY total_value_nzd DESC
        ) AS rank_pallets
    FROM fact_pallet_submissions
) sub
WHERE packhouse_id = 1 
  AND rank_pallets &lt;= 3;
  
  
  -- Obtener el Top 3 de montos únicos más altos para la Packhouse 1
-- Objetivo: Usar DENSE_RANK para que los empates compartan escalón y el podio sea consecutivo (1, 2, 3) sin saltos.
SELECT * FROM (
    SELECT 
        submission_id, 
        packhouse_id, 
        total_value_nzd,
        DENSE_RANK() OVER (
            PARTITION BY packhouse_id 
            ORDER BY total_value_nzd DESC
        ) AS rank_pallets
    FROM fact_pallet_submissions
) sub
WHERE packhouse_id = 1 
  AND rank_pallets &lt;= 3;</sql><current_tab id="0"/></tab_sql></sqlb_project>
